---
import { withBase } from '../lib/url';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="Cockpit App Store 首页">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      <span>Cockpit<span class="brand-secondary"> Apps</span></span>
    </a>
    <nav class="main-nav" aria-label="网站导航">
      <a class={current === withBase('/') ? 'active' : ''} href={withBase('/')}>发现</a>
      <a class={current.startsWith(withBase('/apps/')) ? 'active' : ''} href={withBase('/apps/')}>全部应用</a>
      <a class={current.startsWith(withBase('/about/')) ? 'active' : ''} href={withBase('/about/')}>关于</a>
    </nav>
    <div class="header-actions">
      <a href={withBase('/apps/')} class="header-search" title="浏览应用"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>查找应用</span><kbd>⌘ K</kbd></a>
      <a class="header-github" href="https://github.com/" target="_blank" rel="noopener noreferrer" title="GitHub"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.61-3.37-1.18-3.37-1.18-.45-1.14-1.1-1.45-1.1-1.45-.9-.62.07-.61.07-.61 1 .07 1.53 1.02 1.53 1.02.9 1.52 2.36 1.08 2.93.82.09-.65.35-1.08.64-1.33-2.22-.25-4.55-1.12-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.44-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.66c.85 0 1.7.12 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.54 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.83-2.34 4.69-4.57 4.93.36.31.69.91.69 1.84v2.93c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"/></svg></a>
    </div>
  </div>
</header>
<script>
  document.addEventListener('keydown', event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase()==='k' || (!event.metaKey && !event.ctrlKey && event.key === '/' && !/INPUT|TEXTAREA/.test((event.target as HTMLElement)?.tagName || ''))) {
      const search = document.querySelector<HTMLInputElement>('#catalog-search, #hero-search');
      if (search) { event.preventDefault(); search.focus(); }
    }
  });
</script>
