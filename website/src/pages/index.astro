---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';
import {withBase} from '../lib/url';
import fs from 'node:fs';
import path from 'node:path';
import catalog from '../data/catalog.json';
import type {CatalogApp, CatalogCategory} from '../lib/types';
const apps = catalog.apps as CatalogApp[];
const categories = catalog.categories as CatalogCategory[];
const featured = [...apps].sort((a,b)=>Number(b.featured)-Number(a.featured)||b.recommendWeight-a.recommendWeight||a.name.localeCompare(b.name)).slice(0,8);
const quickCategories=categories.filter(c=>['AI','Database','DevTool','DevOps','Tool','Storage','Media','Security'].includes(c.key));
const count=(key:string)=>apps.filter(a=>a.categories.includes(key)).length;
const detailsDir=path.join(process.cwd(),'src/data/details');
const details=apps.map(app=>JSON.parse(fs.readFileSync(path.join(detailsDir,app.key+'.json'),'utf8')) as {versionsDetailed?:Array<{templateAvailable:boolean}>});
const versionCount=apps.reduce((sum,app)=>sum+app.versions.length,0);
const composeVersions=details.reduce((sum,detail)=>sum+(detail.versionsDetailed||[]).filter(v=>v.templateAvailable).length,0);
const composeApps=details.filter(detail=>(detail.versionsDetailed||[]).some(v=>v.templateAvailable)).length;
const gpuApps=apps.filter(app=>app.gpuSupport).length;
const architectureCounts=['amd64','arm64','arm/v7'].map(arch=>({arch,count:apps.filter(app=>app.architectures.includes(arch)).length}));
const categoryStats=categories.map(category=>({category,count:count(category.key)})).filter(item=>item.count>0).sort((a,b)=>b.count-a.count).slice(0,8);
const maxCategoryCount=categoryStats[0]?.count||1;
---
<BaseLayout>
  <section class="directory-overview">
    <div class="container overview-inner">
      <header class="overview-heading">
        <div><div class="eyebrow">CATALOG OVERVIEW</div><h1>应用目录数据概览</h1><p>按分类、容器模板与运行架构了解当前收录情况。</p></div>
        <a class="button-outline" href={withBase('/apps/')}>浏览应用 <span>↗</span></a>
      </header>
      <div class="overview-metrics" aria-label="目录统计">
        <div class="overview-metric"><span>收录应用</span><strong>{apps.length}</strong><small>个开源项目</small></div>
        <div class="overview-metric"><span>应用分类</span><strong>{categories.length}</strong><small>个领域</small></div>
        <div class="overview-metric"><span>版本配置</span><strong>{versionCount}</strong><small>个版本条目</small></div>
        <div class="overview-metric metric-container"><span>含 Compose 模板</span><strong>{composeApps}</strong><small>覆盖 {composeVersions} 个版本模板</small></div>
        <div class="overview-metric"><span>GPU 相关</span><strong>{gpuApps}</strong><small>个应用标记支持</small></div>
      </div>
      <div class="overview-panels">
        <section class="overview-panel category-stats">
          <div class="overview-panel-head"><div><h2>分类分布</h2><p>按应用关联分类计数</p></div><span>{categories.length} 类</span></div>
          <div class="category-bars">
            {categoryStats.map(item=><a class="category-bar-row" href={withBase('/apps/?category='+item.category.key)}>
              <span class="category-bar-label">{item.category.label}</span><span class="category-bar-track"><span style={`width:${Math.max(4,item.count/maxCategoryCount*100)}%`}></span></span><strong>{item.count}</strong>
            </a>)}
          </div>
        </section>
        <section class="overview-panel runtime-stats">
          <div class="overview-panel-head"><div><h2>容器与运行环境</h2><p>来自收录的应用版本模板</p></div><span class="runtime-mark">▣</span></div>
          <div class="runtime-highlight"><strong>{composeVersions}</strong><span>个版本提供 Compose 模板</span></div>
          <div class="runtime-line"><span>amd64</span><div><i style={`width:${apps.length?architectureCounts[0].count/apps.length*100:0}%`}></i></div><strong>{architectureCounts[0].count}</strong></div>
          <div class="runtime-line"><span>arm64</span><div><i style={`width:${apps.length?architectureCounts[1].count/apps.length*100:0}%`}></i></div><strong>{architectureCounts[1].count}</strong></div>
          <div class="runtime-line"><span>arm/v7</span><div><i style={`width:${apps.length?architectureCounts[2].count/apps.length*100:0}%`}></i></div><strong>{architectureCounts[2].count}</strong></div>
          <p class="runtime-note">模板仅供参考，原始部署依赖可能需要适配。</p>
        </section>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading"><div><div class="eyebrow">BROWSE BY CATEGORY</div><h2>从你感兴趣的领域开始</h2><p>清晰分类，快速发现适合的开源服务。</p></div><a class="section-link" href={withBase('/apps/')}>全部应用 <span>↗</span></a></div>
      <div class="category-grid">
        {quickCategories.map((category,index)=><a class="category-tile" href={withBase('/apps/?category='+category.key)}>
          <span class:list={['category-symbol','symbol-'+index]}>{['✦','▤','⌘','◇','⚙','◫','♫','◈'][index]}</span>
          <span class="category-content"><strong>{category.label}</strong><small>{count(category.key)} 款应用</small></span>
          <span class="category-arrow">↗</span>
        </a>)}
      </div>
    </div>
  </section>
  <section class="section section-muted">
    <div class="container">
      <div class="section-heading"><div><div class="eyebrow">EDITOR'S PICKS</div><h2>精选应用</h2><p>从活跃的开源项目中，发现值得尝试的工具。</p></div><a class="section-link" href={withBase('/apps/')}>探索全部 <span>↗</span></a></div>
      <div class="app-grid">{featured.map(app=><AppCard app={app} categories={categories}/>)}</div>
      <div class="explore-more"><a class="button-outline" href={withBase('/apps/')}>浏览全部 {apps.length} 款应用 <span>→</span></a></div>
    </div>
  </section>
  <section class="container ending-banner">
    <div><div class="eyebrow">BUILT FOR OPEN SOURCE</div><h2>好工具，值得被更多人发现。</h2><p>基于开源目录自动生成，持续同步应用信息，让探索始终简单。</p></div>
    <a href={withBase('/about/')} class="button-light">了解 Cockpit Apps <span>↗</span></a>
  </section>
</BaseLayout>
