{
  "name": "cockpit-appstore",
  "private": true,
  "version": "0.1.0",
  "description": "A Git-driven, static open-source app catalog powered by Astro",
  "scripts": {
    "setup": "node scripts/setup-website.mjs",
    "dev": "cd website && npm run dev",
    "build": "cd website && npm run build",
    "check": "cd website && npm run check",
    "preview": "cd website && npm run preview",
    "data:generate": "cd website && npm run data:generate",
    "data:validate": "cd website && npm run data:validate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
